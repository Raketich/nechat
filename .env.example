# Copy to server/.env and fill in your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Any free model from https://openrouter.ai/models?q=free (suffix ":free").
# Popular free models sometimes answer 429 "rate-limited upstream" — that is
# shared provider capacity, not your account. Just switch to another :free
# model and restart the server (.env is read once at startup).
OPENROUTER_MODEL=google/gemma-4-31b-it:free
